// Module descriptor for moonbean.
// See https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "sundaysebasidian-byte/moonbean"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/sundaysebasidian-byte/moonbean"

license = "Apache-2.0"

keywords = [
  "beancount",
  "accounting",
  "double-entry",
  "ledger",
  "finance",
  "bql",
]

preferred_target = "wasm-gc"

description = "A Beancount v3 compatible plain-text double-entry accounting engine in MoonBit: parser, booking, validation, reports and BQL queries, embeddable in native, wasm and js."
