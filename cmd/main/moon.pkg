import {
  "moonbitlang/core/path",
  "sundaysebasidian-byte/moonbean",
  "sundaysebasidian-byte/moonbean/ast",
  "sundaysebasidian-byte/moonbean/query",
  "sundaysebasidian-byte/moonbean/realization",
  "sundaysebasidian-byte/moonbean/validation",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
}

supported_targets = "-all+native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async/fs" ],
)

pkgtype(kind: "executable")
