2024-01-01 open Assets:A USD
2024-01-01 open Equity:B USD
2024-01-02 * "one" #b #a ^y ^x
  Assets:A 1 USD
  Equity:B -1 USD
2024-01-03 * "P" "two" #a #b ^x ^y
  Assets:A 2 USD
  Equity:B -2 USD
2024-01-04 * "empty"
  Assets:A 3 USD
  Equity:B -3 USD
2024-01-05 * "other" #a ^x
  Assets:A 4 USD
  Equity:B -4 USD
2024-01-06 note Assets:A "one" #b #a ^x
2024-01-07 note Assets:A "two" #a #b ^x
2024-01-08 note Assets:A "empty"
2024-01-09 note Assets:A "other" #a
